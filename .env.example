# Copy to .env (which is git-ignored) and replace the placeholders.
# Generate values with:  openssl rand -hex 32
DB_PASSWORD=change-me
# At least 32 characters (HS256 needs a 256-bit key).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Optional: host port for the app (default 8080).
# APP_PORT=8080
